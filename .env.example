# Copy this file to .env and fill in real values. Never commit .env.
#
# See docs/ROADMAP.md (Milestone 0) and docs/ARCHITECTURE.md Open Question #9
# for context on why these specific variables exist at this stage.

# PostgreSQL connection string. In production this is a Supabase project's
# connection string (Project Settings -> Database -> Connection string). For
# local development, this points at the Postgres service started by
# `docker compose up db` (see docker-compose.yml).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/web3_hunter"

# Better Auth's session-signing secret. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-32+-character-secret"

# The base URL Better Auth uses to construct callback/redirect URLs.
BETTER_AUTH_URL="http://localhost:3000"

# The app's own public URL, used for links generated server-side (e.g. in
# outreach drafts and notification emails, starting in later milestones).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Optional: AI Enrichment Layer (packages/ai) ---
# Every variable below is optional and independent of the rest of the
# system: leaving AI_PROVIDER unset makes getAIProvider() return null and
# every AI-dependent route degrade to "unavailable" rather than erroring.

# Selects the provider: "openai", "anthropic", or "mock" (generates
# canned content with no external calls or credentials — useful for local
# development and CI).
# AI_PROVIDER="mock"

# Required only when AI_PROVIDER="openai".
# OPENAI_API_KEY=""
# OPENAI_MODEL=""

# Required only when AI_PROVIDER="anthropic".
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL=""

# --- Optional: GitHub Collector (packages/collectors) ---
# Optional. GitHub's REST API serves a public org's public repositories
# unauthenticated; a token only raises the rate limit (60 requests/hour
# unauthenticated vs. 5,000/hour authenticated). No scopes are required.
# GITHUB_TOKEN=""
